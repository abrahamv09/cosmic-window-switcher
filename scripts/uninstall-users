#!/bin/sh

set -u

case ${1:-} in
    remove|deconfigure)
        ;;
    *)
        exit 0
        ;;
esac

getent_command=${COSMIC_WINDOW_SWITCHER_GETENT:-/usr/bin/getent}
runuser_command=${COSMIC_WINDOW_SWITCHER_RUNUSER:-/usr/sbin/runuser}
switcher_binary=${COSMIC_WINDOW_SWITCHER_BINARY:-/usr/bin/cosmic-window-switcher}
application_id=io.github.abrahamv09.CosmicWindowSwitcher
cleanup_failed=0
passwd_entries=$("$getent_command" passwd) || exit 1

while IFS=: read -r user _ uid _ _ home _; do
    case $uid in
        ''|*[!0-9]*)
            continue
            ;;
    esac
    [ "$uid" -ne 0 ] || continue
    [ -n "$home" ] || continue

    locator="$home/.local/state/cosmic/$application_id/v1/uninstall-environment"
    if [ -f "$locator" ]; then
        config_home=$(/usr/bin/sed -n 's/^config_home=//p' "$locator")
        state_home=$(/usr/bin/sed -n 's/^state_home=//p' "$locator")
        case $config_home:$state_home in
            *'
'*|:*|*:)
                echo "cosmic-window-switcher: invalid uninstall locator for $user" >&2
                cleanup_failed=1
                continue
                ;;
        esac
        if [ ! -f "$state_home/cosmic/$application_id/v1/integration" ]; then
            echo "cosmic-window-switcher: uninstall locator for $user has no lifecycle journal" >&2
            cleanup_failed=1
            continue
        fi
    else
        config_home="$home/.config"
        state_home="$home/.local/state"
        [ -f "$state_home/cosmic/$application_id/v1/integration" ] || continue
    fi
    case $config_home:$state_home in
        /*:/*)
            ;;
        *)
            echo "cosmic-window-switcher: invalid uninstall locator for $user" >&2
            cleanup_failed=1
            continue
            ;;
    esac
    if ! "$runuser_command" -u "$user" -- /usr/bin/env \
        "HOME=$home" \
        "XDG_CONFIG_HOME=$config_home" \
        "XDG_STATE_HOME=$state_home" \
        "XDG_RUNTIME_DIR=/run/user/$uid" \
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus" \
        "$switcher_binary" disable --uninstall
    then
        echo "cosmic-window-switcher: could not restore integration for $user; run 'cosmic-window-switcher disable' before retrying removal" >&2
        cleanup_failed=1
    fi
done <<EOF
$passwd_entries
EOF

exit "$cleanup_failed"
